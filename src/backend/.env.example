# CareerSetu AI — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit real keys.

# ─── Database ───
# Supabase Postgres connection string (same for dev & prod)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# ─── File Storage ───
# Local uploads dir (default: ./uploads). For prod, switch to S3/R2.
UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── External API Keys (stub in dev, wire in prod) ───
BHASHINI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
FIREBASE_SERVER_KEY=
MSG91_API_KEY=
GUPSHUP_API_KEY=
SENDGRID_API_KEY=

# ─── Geocoding ───
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ─── Auth & Security ───
JWT_SECRET=change-me-to-a-random-string

# ─── Monitoring ───
SENTRY_DSN=

# ─── Resume Parsing (optional upgrade) ───
AFFINDA_API_KEY=

# ─── Watsonx AI Explanations ───
WATSONX_EXPLANATIONS_ENABLED=false
# Leave WATSONX_EXPLANATIONS_ENABLED=false or API key empty to fallback to template explanations
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
